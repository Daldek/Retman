# Environment variables read by Retman (DEV-13.1, DEV-18.3). Retman reads the process
# environment and does not load .env itself: export what you need, for example with
# `set -a; . ./.env; set +a`.
# Precedence: command-line option, RETMAN_<KEY>, NOGAT_<KEY>, the config file, default.

# Log level of the command line on stderr: debug, info, warning or error (default
# warning). --verbose means debug, --quiet means error.
RETMAN_LOG_LEVEL=

# Log level shared by the Nogat tools; RETMAN_LOG_LEVEL wins over it.
NOGAT_LOG_LEVEL=

# The API key of an external model provider is read from the variable that
# `api_key_env` names in the [decision] table of the config file; list that variable
# here when you use one. Retman has no variable of its own for keys.
