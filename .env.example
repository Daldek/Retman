# Environment variables read by Retman (DEV-13.1, DEV-18.3). Retman reads the process
# environment and does not load .env itself: export what you need, for example with
# `set -a; . ./.env; set +a`. An empty variable counts as unset.
# Precedence: command-line option, RETMAN_<KEY>, NOGAT_<KEY> (shared keys only), the
# [retman] tables of nogat.toml, the [nogat] table (shared keys only), the default.
# <KEY> is the dotted setting in capitals with underscores: decision.url is
# RETMAN_DECISION_URL. `retman config show` lists every setting with its value and source.

# The settings file nogat.toml; the default is in the user configuration folder of nogat.
NOGAT_CONFIG=

# --- Shared keys: the variable of Retman wins over the one shared by the Nogat tools ---

# Language of the texts for people (questions, options, messages): pl or en. The --json
# output is always English.
RETMAN_LANG=
NOGAT_LANG=

# Log level of the command line on stderr: debug, info, warning or error (default
# warning). --verbose means debug, --quiet means error.
RETMAN_LOG_LEVEL=
NOGAT_LOG_LEVEL=

# Parent of the data stores and of the command collection (default: the user data
# folder of nogat); the stores are <data_dir>/kartograf and <data_dir>/imgw.
RETMAN_DATA_DIR=
NOGAT_DATA_DIR=

# Parent of the caches (default: the user cache folder of nogat).
RETMAN_CACHE_DIR=
NOGAT_CACHE_DIR=

# --- The model server [retman.decision]: no default, planning needs it ---

# basal or openai_compatible.
RETMAN_DECISION_BACKEND=
RETMAN_DECISION_URL=
RETMAN_DECISION_MODEL=
# Seconds to wait for the model server.
RETMAN_DECISION_TIMEOUT_S=
# The NAME of the variable that holds the API key of an external model provider; the key
# itself is read from that variable and never from the settings file. Export that
# variable too when you use one.
RETMAN_DECISION_API_KEY_ENV=
# auto, logprobs, consistency or none (backend openai_compatible).
RETMAN_DECISION_CONFIDENCE=
RETMAN_DECISION_CONSISTENCY_RUNS=
# A number in (0, 1], or auto with the backend basal.
RETMAN_DECISION_THRESHOLDS_OPERATION=
RETMAN_DECISION_THRESHOLDS_PARAMETER=

# --- The other settings ---

RETMAN_TEXT_BACKEND=
# Results folder inside the project folder (default retman-output).
RETMAN_OUTPUT_RESULTS_DIR=
# Tools to enable, separated by commas (default: every installed supported tool).
RETMAN_ADAPTERS_ENABLED=
# Kartograf: the store (default <data_dir>/kartograf), the metadata cache (default
# <cache_dir>/kartograf/metadata.db), parallel transfers and the update mode
# (local, upgrade or force).
RETMAN_TOOLS_KARTOGRAF_STORE_DIR=
RETMAN_TOOLS_KARTOGRAF_CACHE_FILE=
RETMAN_TOOLS_KARTOGRAF_WORKERS=
RETMAN_TOOLS_KARTOGRAF_UPDATE=
# IMGWTools: the store (default <data_dir>/imgw) and the reference files (default
# <cache_dir>/imgw/reference).
RETMAN_TOOLS_IMGWTOOLS_STORE_DIR=
RETMAN_TOOLS_IMGWTOOLS_REFERENCE_DATA_DIR=
# true or false: keep command texts and answers in the project journal (default true).
RETMAN_LOG_JOURNAL_COMMANDS=
# true or false: collect commands of all projects in one file, only with your consent
# (default false), and where (default <data_dir>/retman/collected.jsonl).
RETMAN_PRIVACY_COLLECT_COMMANDS=
RETMAN_PRIVACY_COLLECT_PATH=
