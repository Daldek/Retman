{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Retman/blob/main/src/retman/schemas/retman-results-1.schema.json",
  "title": "retman-results/1",
  "description": "The numbered results of the project folder, in numeric order. It is the `result` of the envelope retman-result/1. Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "directory",
    "results"
  ],
  "properties": {
    "schema": {
      "const": "retman-results/1"
    },
    "directory": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "number",
          "operation",
          "ok",
          "summary",
          "finished_at"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "operation": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "summary": {
            "type": "string"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
